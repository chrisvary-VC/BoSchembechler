# ---- LiveKit (one project; the agent and the HUD MUST share it) ----
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Speech to text ----
DEEPGRAM_API_KEY=

# ---- The brain (local Ollama; no OpenAI account or API key required) ----
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_TIMEOUT_SECONDS=60
AIOS_LLM_MODEL=gemma4:e2b

# ---- The voice ----
ELEVENLABS_MODEL=eleven_flash_v2_5
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_turbo_v2_5
# Lower stability = livelier. 0.3 lively, 0.5 calm.
ELEVENLABS_STABILITY=0.35
ELEVENLABS_SIMILARITY=0.75
ELEVENLABS_STYLE=0.45

# ---- Data source ----
# 1 = read seed/*.json (bulletproof, for filming). 0 = live DB with seed fallback.
AIOS_DEMO_MODE=0
AIOS_WEB_PORT=4310
GA4_PROPERTY_IDS=
