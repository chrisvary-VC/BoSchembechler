# Must be the SAME LiveKit project the agent uses, or you join different rooms
# and nothing shows up on screen.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Everyone who joins this room name shares the session with the agent.
NEXT_PUBLIC_AIOS_ROOM=aios

# Server-only access gate. Store a salted scrypt hash, never the plain password.
JARVIS_GATE_PASSWORD_HASH=
JARVIS_SESSION_SECRET=
